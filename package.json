    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --config .prettierrc --write --log-level error \"src/**/*.{js,ts,json,css}\" vite.config.ts eslint.config.js",
    "prepare": "husky"
