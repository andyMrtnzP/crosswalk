{
  "name": "crosswalk",
  "private": true,
  "version": "0.1.0",
  "description": "A Navidrome Player",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/andyMrtnzP/crosswalk.git"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && npm run lint && tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "start:api": "tsx server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --config .prettierrc --write --log-level error \"src/**/*.{js,ts,json,css}\" \"server/**/*.ts\" vite.config.ts eslint.config.js README.md",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "andyMrtnzP",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2",
    "lowdb": "^7.0.1",
    "lucide-react": "^0.554.0",
    "md5": "^2.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/express-http-proxy": "^1.6.7",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.12"
  }
}
